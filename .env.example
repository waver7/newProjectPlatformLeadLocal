DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadmarketplace"
AUTH_SECRET="replace-with-secure-random-string"
NEXTAUTH_URL="http://localhost:3000"
APP_NAME="Local Lead Marketplace"
# Resend — free email sending (resend.com). If omitted, emails are logged to console instead.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: override the From address (must be from a verified domain in Resend)
# During development the default onboarding@resend.dev sender works for any recipient.
MAIL_FROM="LeadLocal <onboarding@resend.dev>"

